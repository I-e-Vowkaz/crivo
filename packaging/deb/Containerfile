# Ambiente de build do .deb: Ubuntu 22.04 (glibc 2.35), para o pacote rodar no
# Ubuntu 22.04 ou mais novo e no Debian 12. Usado por packaging/deb/build.sh.
FROM docker.io/library/ubuntu:22.04

ARG RUST_VERSION=1.100.0
ARG NODE_VERSION=22.23.1

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl file pkg-config xz-utils \
        libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev \
        librsvg2-dev libssl-dev libdbus-1-dev libxdo-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
    | tar -xJ -C /usr/local --strip-components=1

ENV CARGO_HOME=/usr/local/cargo RUSTUP_HOME=/usr/local/rustup PATH=/usr/local/cargo/bin:$PATH
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain "${RUST_VERSION}"

WORKDIR /build
