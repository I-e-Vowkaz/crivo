{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PR Review Orchestrator",
  "version": "0.1.0",
  "identifier": "com.vowkaz.crivo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PR Review Orchestrator",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../claude/": "claude/"
    },
    "publisher": "Vowkaz",
    "category": "DeveloperTool",
    "shortDescription": "Review de PRs do Bitbucket com agentes Claude Code"
  }
}
